            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 25px 40px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 30px;
            margin: 0 5%;
        }

        .feature-box {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .feature-box i {
            font-size: 2rem;
            color: var(--accent-cyan);
        }

        .feature-box h4 {
            font-size: 0.9rem;
            font-weight: 700;
            margin-bottom: 3px;
        }

        .feature-box p {
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        /* JUAL BELI & TESTIMONI & LOKASI */
        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 30px;
        }

        .info-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 25px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .info-card h3 {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.1rem;
            margin-bottom: 15px;
        }

        .testimonial-user {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 15px;
        }

        .testimonial-user img {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            object-fit: cover;
        }

        .stars {
            color: #ffc107;
            font-size: 0.8rem;
            margin-bottom: 3px;
        }

        .map-placeholder {
            background: #112240;
            height: 120px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-top: 15px;
            border: 1px dashed var(--border-color);
        }

        /* FOOTER */
        footer {
            background: #03070e;
            padding: 40px 5%;
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .footer-socials {
            display: flex;
            gap: 15px;
        }

        .footer-socials a {
            background: var(--bg-card);
            color: var(--text-main);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            border: 1px solid var(--border-color);
            transition: 0.3s;
        }

        .footer-socials a:hover {
            background: var(--accent-cyan);
            color: var(--bg-primary);
        }

        footer p {
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        /* RESPONSIVE */
        @media (max-width: 992px) {
            .hero-content, .about-section, .info-grid {
                grid-template-columns: 1fr;
            }
            nav ul {
                display: none;
            }
        }
    </style>
</head>
