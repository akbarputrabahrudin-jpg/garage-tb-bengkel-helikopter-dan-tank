            --bg-secondary: #0a1324;
            --bg-card: #0d1a30;
            --accent-blue: #0084ff;
            --accent-cyan: #00d2ff;
            --text-main: #ffffff;
            --text-muted: #94a3b8;
            --border-color: rgba(0, 132, 255, 0.2);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-main);
            overflow-x: hidden;
        }

        /* HEADER / NAVBAR */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 5%;
            background: rgba(5, 11, 20, 0.85);
            backdrop-filter: blur(10px);
            z-index: 1000;
            border-bottom: 1px solid var(--border-color);
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-container img {
            width: 45px;
            height: 45px;
            object-fit: contain;
        }

        .logo-text h1 {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.2rem;
            font-weight: 900;
            letter-spacing: 1px;
            color: #fff;
        }

        .logo-text p {
            font-size: 0.65rem;
            color: var(--text-muted);
            letter-spacing: 0.5px;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 30px;
        }

        nav ul li a {
            text-decoration: none;
            color: var(--text-muted);
            font-size: 0.9rem;
            font-weight: 500;
            transition: color 0.3s;
        }

        nav ul li a:hover, nav ul li a.active {
            color: var(--accent-cyan);
        }

        .btn-whatsapp-nav {
            background: linear-gradient(135deg, #00d2ff, #0084ff);
            color: white;
            padding: 10px 20px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 4px 15px rgba(0, 132, 255, 0.4);
            transition: transform 0.3s;
        }

        .btn-whatsapp-nav:hover {
            transform: translateY(-2px);
        }

        /* HERO SECTION */
        .hero {
            position: relative;
            padding: 160px 5% 80px 5%;
            background: linear-gradient(to bottom, rgba(5,11,20,0.6), rgba(5,11,20,0.9)), 
                        url('https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
            display: flex;
            flex-direction: column;
            gap: 50px;
            border-bottom: 1px solid var(--border-color);
        }

        .hero-content {
            display: grid;
            grid-template-columns: 1.2fr 1fr;
            gap: 40px;
            align-items: center;
        }

        .hero-text h2 {
            font-family: 'Orbitron', sans-serif;
            font-size: 3rem;
            font-weight: 900;
            line-height: 1.1;
            margin-bottom: 15px;
            background: linear-gradient(90deg, #ffffff, #00d2ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-text h3 {
            font-size: 1.1rem;
            color: var(--accent-cyan);
            font-weight: 600;
            margin-bottom: 25px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .hero-text p {
            color: var(--text-muted);
            font-size: 1rem;
            line-height: 1.6;
            margin-bottom: 30px;
        }

        .hero-badges {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .badge-item {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 10px 15px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .badge-item i {
            font-size: 1.5rem;
            color: var(--accent-cyan);
        }

        .badge-item span {
            font-size: 0.8rem;
            font-weight: 600;
            display: block;
        }

        .badge-item small {
            font-size: 0.7rem;
            color: var(--text-muted);
        }

        .btn-primary-glow {
